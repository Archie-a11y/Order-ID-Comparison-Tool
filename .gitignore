# ==========================================
# PHP Composer Dependencies (绝不上传依赖包)
# ==========================================
/vendor/

# ==========================================
# Temporary Uploads (不上传本地测试产生的临时文件)
# ==========================================
# 由于您的 PHP 代码中包含自动创建 uploads 目录的逻辑：
# @mkdir($uploadDir, 0755, true); 
# 因此可以直接安全地忽略整项 uploads 文件夹
/uploads/

# ==========================================
# Operating System Files (忽略系统自动生成的垃圾文件)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# IDEs and Text Editors (忽略编辑器配置文件)
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?